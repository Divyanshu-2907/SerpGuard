# Copy to .env and fill in: `cp .env.example .env`
# .env is gitignored; this file is committed. Real environment variables always
# win over values in .env, so this is safe to keep alongside a deployed config.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key — extracts claims from the input and rules on the evidence.
# Without it every check answers 500 credential_missing. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# SerpApi key — runs the Google search that supplies the evidence for each claim.
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Keys that clients of THIS service send in the X-API-Key header; comma separated
# so they can be rotated without downtime. Keep `demo-key` to let the browser demo
# at GET / work. Generate more with: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
SERPGUARD_API_KEYS=demo-key

# MongoDB connection string for the verdict cache. Optional locally (defaults to
# mongodb://127.0.0.1:27017/serpguard_development); REQUIRED in production, where
# a missing value fails the boot loudly rather than silently using localhost.
MONGODB_URI=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# MongoDB for the test suite only. Defaults to mongodb://127.0.0.1:27017/serpguard_test;
# set it to point `bundle exec rspec` at a different mongod.
MONGODB_URI_TEST=

# Puma worker count. Set to 1 on a small single instance — each worker loads the
# whole app, and Rack::Attack's counters are per-instance regardless.
WEB_CONCURRENCY=

# Decrypts config/credentials.yml.enc. Needed only where config/master.key is
# absent (i.e. production). Nothing in the app reads Rails credentials today.
RAILS_MASTER_KEY=
